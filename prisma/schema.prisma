// Prisma schema — Teru POS (plataforma multiempresa)
//
// Estrategia de aislamiento multi-tenant: shared schema + companyId.
// Toda tabla que pertenece a una empresa lleva companyId; el filtrado por
// tenant se aplica siempre en src/server/data (capa de acceso a datos),
// nunca en los servicios ni en la interfaz.
//
// "User" (personal interno) y "Customer" (clientes finales) se modelan por
// separado a propósito: son audiencias con login independiente y el riesgo
// de una fuga de privilegios (un cliente heredando permisos de staff) baja
// si nunca comparten tabla ni lógica de autorización.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Tenant -----------------------------------------------------------

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  currency   String   @default("COP")
  dateFormat String   @default("DD/MM/YYYY")
  // Zona horaria IANA: define el "día" de las ventas y los turnos.
  timeZone   String   @default("America/Bogota")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Datos del asistente de configuración; opcionales y sin formato de un
  // país en particular.
  taxId                    String?
  phone                    String?
  email                    String?
  address                  String?
  // null = el propietario aún no completa el asistente de configuración.
  setupCompletedAt         DateTime?
  // Ruta del logo en el almacenamiento de archivos (no la URL: la URL
  // pública depende del proveedor configurado). null = sin logo.
  logoPath                 String?
  // Correos que reciben el reporte al cerrar el último turno del día (en
  // minúsculas, sin repetidos). Vacío = no se envía. CHECK de máximo 5 en
  // la migración.
  closingReportEmails      String[]  @default([])
  // Último número de venta usado. Se incrementa dentro de la transacción de
  // la venta: el consecutivo queda sin huecos.
  lastSaleNumber           Int       @default(0)
  // Último número de compra confirmada (se asigna al confirmar, no al
  // crear el borrador: borrar un borrador no deja huecos).
  lastPurchaseNumber       Int       @default(0)
  // Último número de conteo físico confirmado (se asigna al confirmar).
  lastInventoryCountNumber Int       @default(0)

  users               User[]
  userSessions        UserSession[]
  customers           Customer[]
  branches            Branch[]
  staffInvitations    StaffInvitation[]
  productCategories   ProductCategory[]
  products            Product[]
  warehouses          Warehouse[]
  supplies            Supply[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  recipeItems         ProductRecipeItem[]
  paymentMethods      PaymentMethod[]
  cashSessions        CashSession[]
  sales               Sale[]
  saleLines           SaleLine[]
  salePayments        SalePayment[]
  thirdParties        ThirdParty[]
  purchases           Purchase[]
  purchaseLines       PurchaseLine[]
  inventoryCounts     InventoryCount[]
  inventoryCountLines InventoryCountLine[]
  expenseCategories   ExpenseCategory[]
  cashMovements       CashMovement[]

  @@map("companies")
}

// Sucursal. La migración garantiza una sola principal (isMain) por empresa
// con un índice único parcial, que Prisma no puede declarar.
model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  address   String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses   Warehouse[]
  cashSessions CashSession[]
  sales        Sale[]

  @@unique([companyId, name])
  // Destino de la FK compuesta de warehouses (aislamiento entre empresas).
  @@unique([companyId, id])
  @@index([companyId])
  @@map("branches")
}

// --- Catálogo de venta ---------------------------------------------------

// Categoría del catálogo. `position` es el orden en que se muestran (POS).
// La migración agrega un índice único por empresa sobre lower(name), que
// Prisma no puede declarar: "Bebidas" y "bebidas" son la misma.
// Solo se borra si nunca tuvo productos (la FK de products lo impide).
model ProductCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  position  Int
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  // Destino de la FK compuesta de products (aislamiento entre empresas).
  @@unique([companyId, id])
  @@index([companyId, position])
  @@map("product_categories")
}

// Producto de venta. No se borra (lo referenciarán las ventas): se archiva.
// La categoría se enlaza por (companyId, categoryId), así la BD impide
// usar una categoría de otra empresa. Nombre único por empresa sobre
// lower(name), en la migración.
model Product {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  categoryId  String
  category    ProductCategory @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  name        String
  description String?
  // Precio final al público, en la moneda de la empresa.
  price       Decimal         @db.Decimal(12, 2)
  // Ruta de la foto en el almacenamiento de archivos (null = sin foto).
  imagePath   String?
  isArchived  Boolean         @default(false)
  // false = agotado: sigue en el catálogo pero no se puede vender.
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recipeItems ProductRecipeItem[]
  saleLines   SaleLine[]

  // Destino de la FK compuesta de product_recipe_items y sale_lines.
  @@unique([companyId, id])
  @@index([companyId, categoryId])
  @@map("products")
}

// --- Inventario ------------------------------------------------------------

// Unidades fijas en código (ver src/lib/units.ts: familias y conversión).
enum StockUnit {
  G
  KG
  ML
  L
  UNIT
}

enum StockMovementType {
  // Primera carga del saldo de un insumo en una bodega.
  INITIAL
  // Corrección manual (entrada o salida), con motivo.
  ADJUSTMENT
  // Salida por una venta (receta del producto).
  SALE
  // Devolución al anular una venta.
  SALE_VOID
  // Entrada por una compra confirmada.
  PURCHASE
  // Salida al anular una compra.
  PURCHASE_VOID
  // Diferencia de un conteo físico confirmado (entrada o salida).
  COUNT
}

// Bodega de una sucursal. La sucursal se enlaza por (companyId, branchId),
// así la BD impide usar una de otra empresa. La migración agrega: una sola
// principal por sucursal (índice parcial) y nombre único por empresa sobre
// lower(name). No se borra (la referencian los movimientos): se desactiva.
model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId  String
  branch    Branch   @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  name      String
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  purchases       Purchase[]
  inventoryCounts InventoryCount[]

  @@unique([companyId, id])
  @@index([companyId, branchId])
  @@map("warehouses")
}

// Insumo: lo que se guarda en inventario (harina, queso, gaseosa). Las
// cantidades se expresan en su unidad; la unidad solo cambia mientras no
// tenga movimientos. No se borra: se archiva. Nombre único por empresa
// sobre lower(name), en la migración.
model Supply {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name       String
  unit       StockUnit
  // Stock mínimo deseado (en su unidad); null = sin mínimo.
  minStock   Decimal?  @db.Decimal(14, 3)
  // Existencia ideal: hasta dónde se repone (lista de compras: ideal −
  // existencia, sumando todas las bodegas); null = sin ideal. No menor que
  // el mínimo (lo valida supplySchema). CHECK (idealStock >= 0) en la
  // migración.
  idealStock Decimal?  @db.Decimal(14, 3)
  // Costo de referencia por unidad (en su unidad), en la moneda de la
  // empresa; null = sin costo. Lo escribe una persona hasta que exista el
  // módulo de compras. La migración agrega CHECK (unitCost >= 0).
  unitCost   Decimal?  @db.Decimal(14, 4)
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  recipeItems    ProductRecipeItem[]
  purchaseLines  PurchaseLine[]
  countLines     InventoryCountLine[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("supplies")
}

// Saldo de un insumo en una bodega. Solo cambia junto con un movimiento, en
// la misma transacción. Puede quedar negativo por ventas (ADR 0007).
model StockLevel {
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  supplyId    String
  supply      Supply    @relation(fields: [companyId, supplyId], references: [companyId, id], onDelete: Restrict)
  quantity    Decimal   @default(0) @db.Decimal(17, 6)
  updatedAt   DateTime  @updatedAt

  @@id([warehouseId, supplyId])
  @@index([companyId, supplyId])
  @@map("stock_levels")
}

// Movimiento de inventario (kardex). Inmutable: la capa de datos no expone
// edición ni borrado; un error se corrige con otro movimiento. quantity va
// con signo (+ entra, − sale) y balanceAfter es el saldo que dejó. Las
// ventas pueden dejar el saldo negativo (ver ADR 0007); saleId enlaza los
// movimientos SALE y SALE_VOID con su venta (CHECK en la migración).
// Cantidades con 6 decimales: una receta en g de un insumo en kg se
// convierte sin redondear (0,5 g = 0,0005 kg).
model StockMovement {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  supplyId         String
  supply           Supply            @relation(fields: [companyId, supplyId], references: [companyId, id], onDelete: Restrict)
  type             StockMovementType
  quantity         Decimal           @db.Decimal(17, 6)
  balanceAfter     Decimal           @db.Decimal(17, 6)
  reason           String?
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  saleId           String?
  sale             Sale?             @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict)
  purchaseId       String?
  purchase         Purchase?         @relation(fields: [companyId, purchaseId], references: [companyId, id], onDelete: Restrict)
  inventoryCountId String?
  inventoryCount   InventoryCount?   @relation(fields: [companyId, inventoryCountId], references: [companyId, id], onDelete: Restrict)
  createdAt        DateTime          @default(now())

  @@index([companyId, supplyId, createdAt])
  @@index([saleId])
  @@index([purchaseId])
  @@index([inventoryCountId])
  @@index([warehouseId, supplyId, createdAt])
  @@map("stock_movements")
}

// --- Recetas ---------------------------------------------------------------

// Línea de la receta de un producto: cuánto lleva de un insumo. La unidad
// es de la misma familia que la del insumo (120 g de un insumo en kg); lo
// valida la capa de datos con el insumo bloqueado. Un insumo aparece una
// sola vez por receta. La migración agrega CHECK (quantity > 0).
model ProductRecipeItem {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId String
  product   Product   @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  supplyId  String
  supply    Supply    @relation(fields: [companyId, supplyId], references: [companyId, id], onDelete: Restrict)
  quantity  Decimal   @db.Decimal(14, 3)
  unit      StockUnit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([productId, supplyId])
  @@index([companyId, supplyId])
  @@map("product_recipe_items")
}

// --- Ventas y caja -----------------------------------------------------------

// Método de pago de la empresa. La migración garantiza un solo método de
// efectivo por empresa (índice parcial) y nombre único sobre lower(name).
// El de efectivo lo crea el sistema. No se borra (lo referencian los
// pagos): se desactiva.
model PaymentMethod {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  // Efectivo: cuenta en la caja del turno y admite cambio.
  isCash    Boolean  @default(false)
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SalePayment[]

  @@unique([companyId, id])
  @@index([companyId, position])
  @@map("payment_methods")
}

// Turno de caja de una persona en una sucursal. closedAt null = abierto; la
// migración permite un solo turno abierto por persona (índice parcial). Al
// cerrar se guardan el esperado (fondo + efectivo de las ventas no
// anuladas) y lo contado; después el turno no cambia.
model CashSession {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId      String
  branch        Branch    @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  userId        String
  user          User      @relation("CashSessionOwner", fields: [userId], references: [id], onDelete: Restrict)
  openingAmount Decimal   @db.Decimal(12, 2)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  // Quién cerró: su dueño o un administrador (turno olvidado). Al cerrar
  // otra persona, closingNote lleva el motivo (CHECK en la migración).
  closedById    String?
  closedBy      User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  expectedCash  Decimal?  @db.Decimal(12, 2)
  countedCash   Decimal?  @db.Decimal(12, 2)
  closingNote   String?

  sales     Sale[]
  movements CashMovement[]

  @@unique([companyId, id])
  @@index([companyId, openedAt])
  @@map("cash_sessions")
}

// Categorías de gasto de cada empresa (configurables; unas por defecto al
// crear la empresa). Nombre único por empresa sin distinguir mayúsculas
// (índice en la migración).
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements CashMovement[]

  @@unique([companyId, id])
  @@index([companyId, position])
  @@map("expense_categories")
}

enum CashMovementType {
  // Sale de la caja y es gasto del negocio (con categoría).
  EXPENSE
  // Sale de la caja sin ser gasto (p. ej. a la caja fuerte).
  WITHDRAWAL
  // Entra a la caja sin ser venta (p. ej. sencillo).
  DEPOSIT
}

enum CashMovementStatus {
  RECORDED
  VOIDED
}

// Gasto, retiro o ingreso de efectivo en un turno abierto. No se borra: se
// anula (quién, cuándo y por qué) mientras el turno siga abierto. Reglas
// de categoría, foto y anulación en la migración.
model CashMovement {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashSessionId String
  cashSession   CashSession        @relation(fields: [companyId, cashSessionId], references: [companyId, id], onDelete: Restrict)
  type          CashMovementType
  amount        Decimal            @db.Decimal(12, 2)
  // Solo en gastos.
  categoryId    String?
  category      ExpenseCategory?   @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  note          String?
  // Foto del recibo en el almacenamiento privado (solo en gastos).
  receiptPath   String?
  userId        String
  user          User               @relation("CashMovementRecordedBy", fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  status        CashMovementStatus @default(RECORDED)
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?              @relation("CashMovementVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason    String?

  @@unique([companyId, id])
  @@index([cashSessionId])
  @@index([companyId, createdAt])
  @@map("cash_movements")
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

// Venta de mostrador, cobrada al crearse. Documento inmutable: no se borra
// ni se edita; se anula (estado VOIDED) mientras su turno siga abierto.
model Sale {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Consecutivo por empresa (companies.lastSaleNumber).
  number        Int
  branchId      String
  branch        Branch      @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  cashSessionId String
  cashSession   CashSession @relation(fields: [companyId, cashSessionId], references: [companyId, id], onDelete: Restrict)
  userId        String
  user          User        @relation("SaleCashier", fields: [userId], references: [id], onDelete: Restrict)
  total         Decimal     @db.Decimal(12, 2)
  status        SaleStatus  @default(COMPLETED)
  createdAt     DateTime    @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?       @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason    String?
  // Clave del pedido que genera el POS: si el mismo pedido llega dos veces
  // (reintento tras una caída de red, doble toque), no se crea otra venta.
  clientKey     String?

  lines          SaleLine[]
  payments       SalePayment[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@unique([companyId, clientKey])
  @@index([companyId, createdAt])
  @@index([cashSessionId])
  @@map("sales")
}

// Línea de la venta. Nombre y precio se copian del producto al vender: la
// venta no cambia si después cambia el catálogo.
model SaleLine {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  saleId      String
  sale        Sale    @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict)
  productId   String
  product     Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  position    Int
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  note        String?

  @@index([saleId])
  @@index([companyId, productId])
  @@map("sale_lines")
}

// Pago de una venta (pago mixto = varios). amount es lo aplicado a la venta
// (la suma da el total); tendered, solo en efectivo, lo que entregó el
// cliente: el cambio es tendered − amount.
model SalePayment {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  saleId          String
  sale            Sale          @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Restrict)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [companyId, paymentMethodId], references: [companyId, id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(12, 2)
  tendered        Decimal?      @db.Decimal(12, 2)

  @@index([saleId])
  @@index([companyId, paymentMethodId])
  @@map("sale_payments")
}

// --- Terceros y compras -----------------------------------------------------

// Tercero: persona o empresa con la que el negocio trata. Por ahora solo
// proveedores; los clientes usarán la misma tabla (isCustomer) cuando
// lleguen. No se borra: se archiva. La migración agrega: nombre único por
// empresa sobre lower(name), NIT único por empresa si se escribe y al
// menos un papel (proveedor o cliente).
model ThirdParty {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name       String
  taxId      String?
  phone      String?
  email      String?
  isSupplier Boolean  @default(false)
  isCustomer Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases Purchase[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("third_parties")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

// Compra de insumos a un proveedor. Se arma en borrador (se edita o se
// borra) y al confirmarse entra al inventario de su bodega y actualiza el
// costo promedio de cada insumo; confirmada ya no cambia: se anula (ver
// ADR 0008). total = suma de las líneas.
model Purchase {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Consecutivo por empresa al confirmar (companies.lastPurchaseNumber);
  // null en borrador.
  number          Int?
  supplierId      String
  supplier        ThirdParty     @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  // Número de la factura o remisión del proveedor.
  supplierInvoice String?
  // Día de la compra según la factura (calendario, sin hora).
  purchasedOn     DateTime       @db.Date
  status          PurchaseStatus @default(DRAFT)
  total           Decimal        @default(0) @db.Decimal(14, 2)
  createdById     String
  createdBy       User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedBy     User?          @relation("PurchaseConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  voidedAt        DateTime?
  voidedById      String?
  voidedBy        User?          @relation("PurchaseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason      String?

  lines          PurchaseLine[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@index([companyId, purchasedOn])
  @@index([companyId, supplierId])
  @@map("purchases")
}

// Línea de la compra: cuánto entra de un insumo y lo que se pagó por esa
// línea (con impuestos). La unidad es de la familia del insumo, como en las
// recetas. Un insumo aparece una vez por compra.
model PurchaseLine {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseId String
  purchase   Purchase  @relation(fields: [companyId, purchaseId], references: [companyId, id], onDelete: Restrict)
  supplyId   String
  supply     Supply    @relation(fields: [companyId, supplyId], references: [companyId, id], onDelete: Restrict)
  position   Int
  quantity   Decimal   @db.Decimal(14, 3)
  unit       StockUnit
  lineTotal  Decimal   @db.Decimal(14, 2)

  @@unique([purchaseId, supplyId])
  @@index([companyId, supplyId])
  @@map("purchase_lines")
}

// --- Conteo físico ----------------------------------------------------------

enum InventoryCountStatus {
  DRAFT
  // Definitivo: no se anula (un error se corrige con otro conteo o un
  // ajuste). Ver ADR 0009.
  CONFIRMED
}

// Conteo físico de una bodega. Se arma en borrador; al confirmar, cada
// línea se compara con el saldo del sistema de ese momento y la diferencia
// entra al kardex (movimiento COUNT).
model InventoryCount {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Consecutivo por empresa al confirmar (companies.lastInventoryCountNumber);
  // null en borrador.
  number        Int?
  warehouseId   String
  warehouse     Warehouse            @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  status        InventoryCountStatus @default(DRAFT)
  createdById   String
  createdBy     User                 @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  // Hora de la base al confirmar (la misma de sus movimientos): marca el
  // inicio del período del siguiente conteo.
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?                @relation("InventoryCountConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  lines          InventoryCountLine[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@index([companyId, warehouseId])
  @@map("inventory_counts")
}

// Lo contado de un insumo. Los campos de confirmación quedan null en
// borrador; al confirmar se guardan para que el conteo no cambie después.
model InventoryCountLine {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  countId           String
  count             InventoryCount @relation(fields: [companyId, countId], references: [companyId, id], onDelete: Restrict)
  supplyId          String
  supply            Supply         @relation(fields: [companyId, supplyId], references: [companyId, id], onDelete: Restrict)
  // Unidad del insumo cuando se escribió lo contado (si cambia, no se
  // confirma).
  unit              StockUnit
  countedQuantity   Decimal        @db.Decimal(14, 3)
  // Saldo del sistema al confirmar y contado − sistema.
  systemQuantity    Decimal?       @db.Decimal(17, 6)
  difference        Decimal?       @db.Decimal(17, 6)
  // Costo por unidad del insumo al confirmar; null = sin costo.
  unitCost          Decimal?       @db.Decimal(14, 4)
  // Período desde el conteo anterior del insumo en la bodega (null = sin
  // conteo anterior: desde su primer movimiento) y lo contado entonces.
  periodStart       DateTime?
  previousCounted   Decimal?       @db.Decimal(14, 3)
  // Movimientos netos del período: vendido (consumo teórico, positivo =
  // salió), comprado y cargas iniciales/ajustes (con signo).
  soldQuantity      Decimal?       @db.Decimal(17, 6)
  purchasedQuantity Decimal?       @db.Decimal(17, 6)
  adjustedQuantity  Decimal?       @db.Decimal(17, 6)

  @@unique([countId, supplyId])
  @@index([companyId, supplyId])
  @@map("inventory_count_lines")
}

// --- Personal interno (login "panel operativo") -----------------------

enum StaffRole {
  OWNER
  ADMIN
  STAFF
  CASHIER
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  email        String
  passwordHash String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetTokens      UserPasswordResetToken[]
  sessions                 UserSession[]
  sentInvitations          StaffInvitation[]        @relation("InvitationSender")
  acceptedInvitation       StaffInvitation?         @relation("InvitationAcceptedUser")
  stockMovements           StockMovement[]
  cashSessions             CashSession[]            @relation("CashSessionOwner")
  closedCashSessions       CashSession[]            @relation("CashSessionClosedBy")
  sales                    Sale[]                   @relation("SaleCashier")
  voidedSales              Sale[]                   @relation("SaleVoidedBy")
  createdPurchases         Purchase[]               @relation("PurchaseCreatedBy")
  confirmedPurchases       Purchase[]               @relation("PurchaseConfirmedBy")
  voidedPurchases          Purchase[]               @relation("PurchaseVoidedBy")
  createdInventoryCounts   InventoryCount[]         @relation("InventoryCountCreatedBy")
  confirmedInventoryCounts InventoryCount[]         @relation("InventoryCountConfirmedBy")
  recordedCashMovements    CashMovement[]           @relation("CashMovementRecordedBy")
  voidedCashMovements      CashMovement[]           @relation("CashMovementVoidedBy")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model UserPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("user_password_reset_tokens")
}

// Sesión del personal. La cookie guarda un token aleatorio; aquí solo su
// hash, así una fuga de la BD no permite suplantar sesiones. companyId se
// duplica (ya está en User) para validar la sesión contra la empresa de la
// ruta sin un join extra. persistent = "Recordar mi sesión" y define la
// duración de la renovación deslizante.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tokenHash  String    @unique
  persistent Boolean   @default(false)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
  @@map("user_sessions")
}

// Invitación para dar de alta a un miembro del personal. Tabla aparte (y no
// un User inactivo sin contraseña) para que users solo tenga cuentas reales
// y quede el historial. Como en las sesiones, en BD solo va el hash del
// token. invitedById null = creada por script (p. ej. el primer OWNER).
model StaffInvitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  email       String
  name        String
  role        StaffRole
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  userId      String?   @unique
  user        User?     @relation("InvitationAcceptedUser", fields: [userId], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
  @@map("staff_invitations")
}

// --- Clientes finales (login "cliente") --------------------------------

enum ResetChannel {
  EMAIL
  PHONE
}

model Customer {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  email        String?
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetTokens CustomerPasswordResetToken[]

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
  @@map("customers")
}

model CustomerPasswordResetToken {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    ResetChannel
  tokenHash  String       @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([customerId])
  @@map("customer_password_reset_tokens")
}

// --- Auditoría de autenticación -----------------------------------------

enum ActorType {
  STAFF
  CUSTOMER
  SYSTEM
}

model AuthAuditLog {
  id         String    @id @default(cuid())
  companyId  String?
  actorType  ActorType
  actorId    String?
  action     String
  ipAddress  String?
  userAgent  String?
  // Elemento afectado (p. ej. "PRODUCT" + id del producto). null en los
  // eventos de sesión y en los anteriores a la fase 4.
  targetType String?
  targetId   String?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([actorType, actorId])
  // Historial de un elemento.
  @@index([targetType, targetId])
  // Límite de intentos: conteo de fallos recientes por IP y acción.
  @@index([ipAddress, action, createdAt])
  @@map("auth_audit_logs")
}
