# Desarrollo local: PostgreSQL 17 del equipo (base teru_pos_dev).
# Crear la base una vez: psql -U postgres -c "CREATE DATABASE teru_pos_dev"
# Reemplaza TU-PASSWORD por la contraseña del usuario postgres local.
DATABASE_URL="postgresql://postgres:TU-PASSWORD@localhost:5432/teru_pos_dev"
DIRECT_URL="postgresql://postgres:TU-PASSWORD@localhost:5432/teru_pos_dev"

# Alternativa: Postgres en Docker (docker-compose up)
# POSTGRES_USER=teru_pos
# POSTGRES_PASSWORD=teru_pos
# POSTGRES_DB=teru_pos_dev
# POSTGRES_PORT=5432
# DATABASE_URL="postgresql://teru_pos:teru_pos@localhost:5432/teru_pos_dev?schema=public"

# Ambiente en línea (Supabase, sa-east-1): NO va en este archivo. Sus
# variables van en .env.supabase (ignorado por git) y en Vercel:
# DATABASE_URL = Transaction pooler (puerto 6543, ?pgbouncer=true)
# DIRECT_URL   = Session pooler (puerto 5432, solo migraciones)
# Copia las cadenas exactas desde el dashboard de Supabase: Project > Connect

NODE_ENV=development

# URL pública de la app (enlaces de los correos)
APP_URL="http://localhost:3000"

# Archivos (logos, fotos, recibos). En desarrollo, una carpeta local
# (ignorada por git) servida en /dev/archivos; gana sobre Supabase.
LOCAL_STORAGE_DIR=".archivos-dev"
# En línea: Supabase Storage. SUPABASE_SECRET_KEY: Dashboard > Project
# Settings > API Keys > Secret keys (sb_secret_...). Es secreta.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Correo (Resend). Sin RESEND_API_KEY: en desarrollo los correos se ven en
# /dev/outbox y en producción el envío falla con un error claro. Déjala
# vacía en desarrollo para que los correos no salgan de verdad.
# RESEND_API_KEY: Resend > API Keys, permiso "Sending access" solo para el
# dominio de envío (re_...). Es secreta: nunca en el repositorio ni en el chat.
# MAIL_FROM: remitente de un dominio verificado en Resend.
RESEND_API_KEY=""
MAIL_FROM="Teru POS <reportes@envios.tudominio.com>"

# Datos iniciales (npm run db:seed): propietario de la empresa cliente Su Arepa (primer tenant)
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""

# Llave con que se cifra la clave de la verificación en dos pasos del
# equipo Teru: 32 bytes en base64 (openssl rand -base64 32). Una distinta
# por entorno, secreta; si cambia, hay que reiniciar la verificación de las
# cuentas (teru:create-admin --reset-2fa).
TOTP_ENCRYPTION_KEY=""

# Cuenta del equipo Teru (npm run teru:create-admin): ponerla solo para
# correr el script y quitarla después.
TERU_ADMIN_PASSWORD=""
