# Base de datos de desarrollo: proyecto Supabase "teru-pos-dev" (antes "su-arepa-dev") (sa-east-1, ref icecyozrwddieqshjaga)
# Copia las cadenas exactas desde el dashboard de Supabase: Project > Connect
# DATABASE_URL = Transaction pooler (puerto 6543, para la app)
# DIRECT_URL   = Session pooler o conexión directa (puerto 5432, solo para migraciones)
DATABASE_URL="postgresql://postgres.icecyozrwddieqshjaga:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.icecyozrwddieqshjaga:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Alternativa: Postgres local vía docker-compose (docker-compose up)
# POSTGRES_USER=teru_pos
# POSTGRES_PASSWORD=teru_pos
# POSTGRES_DB=teru_pos_dev
# POSTGRES_PORT=5432
# DATABASE_URL="postgresql://teru_pos:teru_pos@localhost:5432/teru_pos_dev?schema=public"

# Entorno actual: development | staging | production
NODE_ENV=development

# URL pública de la app (enlaces de recuperación de contraseña)
APP_URL="http://localhost:3000"

# Almacenamiento de archivos (logos): Supabase Storage del mismo proyecto.
# SUPABASE_SECRET_KEY: Dashboard > Project Settings > API Keys > Secret keys
# (sb_secret_...). Es secreta: nunca en el repositorio ni en el navegador.
# Sin estas variables la app funciona, pero no se pueden subir logos.
SUPABASE_URL="https://icecyozrwddieqshjaga.supabase.co"
SUPABASE_SECRET_KEY=""

# Datos iniciales (npm run db:seed): propietario de la empresa cliente Su Arepa (primer tenant)
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""
